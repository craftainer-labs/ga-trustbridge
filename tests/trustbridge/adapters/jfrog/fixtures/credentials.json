{
 "source": "Shapes from the JFrog Access API: OIDC integration (POST /access/api/v1/oidc), identity mappings (/oidc/{provider}/identity_mappings, as used by terraform-provider-platform), access tokens (/access/api/v1/tokens) and ping. See src/trustbridge/adapters/jfrog/README.md for what still needs live confirmation. Dummy token values only.",
 "scenarios": {
  "trust_create": {
   "exchanges": [
    {
     "request": {
      "method": "GET",
      "path": "/access/api/v1/oidc/${provider}"
     },
     "response": {
      "status": 404,
      "json": {
       "errors": [
        {
         "message": "OIDC configuration not found"
        }
       ]
      }
     }
    },
    {
     "request": {
      "method": "POST",
      "path": "/access/api/v1/oidc",
      "json": {
       "name": "${provider}",
       "description": "managed by trustbridge",
       "issuer_url": "https://token.actions.githubusercontent.com",
       "audience": "jfrog-github",
       "provider_type": "GitHub",
       "organization": "acme"
      }
     },
     "response": {
      "status": 201,
      "json": {
       "name": "${provider}",
       "description": "managed by trustbridge",
       "issuer_url": "https://token.actions.githubusercontent.com",
       "audience": "jfrog-github",
       "provider_type": "GitHub",
       "organization": "acme"
      }
     }
    },
    {
     "request": {
      "method": "GET",
      "path": "/access/api/v1/oidc/${provider}/identity_mappings/${cred_push}"
     },
     "response": {
      "status": 404,
      "json": {
       "errors": [
        {
         "message": "Identity mapping not found"
        }
       ]
      }
     }
    },
    {
     "request": {
      "method": "POST",
      "path": "/access/api/v1/oidc/${provider}/identity_mappings",
      "json": {
       "name": "${cred_push}",
       "description": "managed by trustbridge",
       "provider_name": "${provider}",
       "project_key": "${project}",
       "priority": 20,
       "claims": {
        "repository_owner_id": "5",
        "repository_id": "10",
        "environment": "prod"
       },
       "token_spec": {
        "username": "${cred_push}",
        "scope": "applied-permissions/roles:${project}:Developer",
        "audience": "*@*",
        "expires_in": 3600
       }
      }
     },
     "response": {
      "status": 201,
      "json": {
       "name": "${cred_push}",
       "description": "managed by trustbridge",
       "provider_name": "${provider}",
       "project_key": "${project}",
       "priority": 20,
       "claims": {
        "repository_owner_id": "5",
