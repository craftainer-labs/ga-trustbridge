{
  "source": "Failure responses of the Kubernetes API; the bodies carry a value that must never reach an AdapterError",
  "scenarios": {
    "http_429": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/apis/argoproj.io/v1alpha1/namespaces/argocd/appprojects/${project}"
          },
          "response": {
            "status": 429,
            "json": {
              "message": "leaky-body-secret"
            }
          }
        }
      ]
    },
    "http_500": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/apis/argoproj.io/v1alpha1/namespaces/argocd/appprojects/${project}"
          },
          "response": {
            "status": 500,
            "json": {
              "message": "leaky-body-secret"
            }
          }
        }
      ]
    },
    "http_503": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/apis/argoproj.io/v1alpha1/namespaces/argocd/appprojects/${project}"
          },
          "response": {
            "status": 503,
            "json": {
              "message": "leaky-body-secret"
            }
          }
        }
      ]
    },
    "http_401": {
      "exchanges": [
        {
          "request": {
            "method": "GET",
            "path": "/apis/argoproj.io/v1alpha1/namespaces/argocd/appprojects/${project}"
          },
