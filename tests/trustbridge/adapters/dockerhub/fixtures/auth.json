{
 "source": "Shapes from Docker's Hub API reference (https://docs.docker.com/reference/api/hub/latest/, OpenAPI 2-beta) and the access-token pages. See src/trustbridge/adapters/dockerhub/README.md for what still needs a live check. Dummy token values only.",
 "scenarios": {
  "health_ok": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "status": 200,
      "json": {
       "access_token": "jwt-bearer-value"
      }
     }
    },
    {
     "request": {
      "method": "GET",
      "path": "/v2/namespaces/acme/repositories?page_size=1"
     },
     "response": {
      "status": 200,
      "json": {
       "results": []
      }
     }
    }
   ]
  },
  "health_unauthorized": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "status": 401,
      "json": {
       "detail": "Incorrect authentication credentials",
       "secret": "dckr_pat_dummy"
      }
     }
    }
   ]
  },
  "login_server_error": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "status": 503
     }
    }
   ]
  },
  "login_no_token": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "status": 200,
      "json": {
       "nope": 1
      }
     }
    }
   ]
  },
  "login_not_json": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "status": 200,
      "text": "<html>"
     }
    }
   ]
  },
  "login_transport_error": {
   "exchanges": [
    {
     "request": {
      "method": "POST",
      "path": "/v2/auth/token",
      "json": {
       "identifier": "svc-tb",
       "secret": "dckr_pat_dummy"
      }
     },
     "response": {
      "raise": "ConnectError"
     }
    }
   ]
  }
 }
}
