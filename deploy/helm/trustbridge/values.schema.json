{
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "production",
        "dev"
      ]
    },
    "database": {
      "type": "object",
      "properties": {
        "sslmode": {
          "type": "string",
          "enum": [
            "disable",
            "allow",
            "prefer",
            "require",
            "verify-ca",
            "verify-full"
          ]
        },
        "pool": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "null",
                "local",
                "external"
              ]
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "health": {
          "type": "object",
          "properties": {
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reconciler": {
      "type": "object",
      "properties": {
        "health": {
          "type": "object",
          "properties": {
            "port": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "global": {},
    "image": {},
    "imagePullSecrets": {},
    "podSecurityContext": {
      "type": "object",
      "minProperties": 1
    },
    "securityContext": {
      "type": "object",
      "minProperties": 1
    },
    "serviceAccount": {},
    "podDisruptionBudget": {},
    "ingress": {},
    "networkPolicy": {},
    "valkey": {},
    "oidc": {},
    "publicBaseUrl": {},
    "registrationStateKey": {},
    "subscriberSecret": {},
    "s3": {},
    "mqtt": {},
    "app": {},
    "securityTxt": {},
    "trustbridge": {
      "type": "object",
      "properties": {
        "audit": {
          "type": "object",
          "properties": {
            "exportLagSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "transactionTimeoutSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "deletion": {
          "type": "object",
          "properties": {
            "pollSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "batchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "leaseTtlSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "budgetFraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "backoffBaseSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "backoffCapSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "drainMaxPasses": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10000
            },
            "drainPollSeconds": {
              "type": "number",
              "minimum": 0
            },
            "stepPassSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "ca": {},
    "proxy": {},
    "otel": {},
    "extraEnv": {},
    "extraEnvFrom": {},
    "extraVolumes": {},
    "extraVolumeMounts": {},
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
