# RustFS local-dev credentials: loaded via env_file: into both the s3
# service (compose.yml, next to this file) and myapp
# (.devcontainer/compose.instance.yml, whose Settings reads these as
# s3_access_key/s3_secret_key -- see src/app/config.py). See CLAUDE.md's "Configuration" section.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
