# Mosquitto local-dev credentials: loaded via env_file: into both the mqtt service
# (compose.yml, next to this file, which builds the broker's password file from them at
# startup) and myapp (../../compose.instance.yml, which hands them to config.py's
# mqtt_username/mqtt_password). Dev-only values, not real secrets: the broker is reachable
# only from other containers on the compose network (see ../README.md).
MQTT_USERNAME=dev-mqtt-user
MQTT_PASSWORD=dev-mqtt-password
