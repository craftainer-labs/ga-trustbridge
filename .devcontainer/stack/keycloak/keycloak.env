# Keycloak local-dev credentials and OIDC endpoints: loaded via env_file:
# into both the keycloak service (compose.yml, next to this file, which
# only consumes KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD) and myapp
# (.devcontainer/compose.instance.yml, whose Settings reads the OIDC_* values
# verbatim -- see src/app/config.py). The realm/client-id baked into the
# OIDC_* URLs below must be kept in sync by hand with realm-export.json --
# see CLAUDE.md's "Devcontainer stack pattern" section.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# OIDC_ISSUER is the `iss` tokens carry (Keycloak's KC_HOSTNAME, the browser-facing
# URL); OIDC_DISCOVERY_URL is where the backend itself reaches Keycloak inside the
# compose network. OIDC_ISSUER_URL (the original single variable, here the internal
# URL) stays only because tests/integration/test_health_checks.py still reads it.
OIDC_ISSUER_URL=http://keycloak:8080/realms/template-fastapi
OIDC_ISSUER=http://localhost:8080/realms/template-fastapi
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/template-fastapi/.well-known/openid-configuration
# Browser-facing (Swagger UI runs the OAuth flow in the browser), unlike the discovery URL.
OIDC_AUTHORIZATION_URL=http://localhost:8080/realms/template-fastapi/protocol/openid-connect/auth
OIDC_TOKEN_URL=http://localhost:8080/realms/template-fastapi/protocol/openid-connect/token
OIDC_CLIENT_ID=api
OIDC_AUDIENCE=api
# Dev-only secret of the confidential `bff` client; realm-export.json
# references it as ${BFF_CLIENT_SECRET} (Keycloak substitutes env vars in
# imported realm files). The BFF reads the same variable. Never reuse.
BFF_CLIENT_SECRET=dev-only-bff-client-secret
