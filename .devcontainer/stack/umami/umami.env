# Umami local-dev configuration: loaded via env_file: into the umami service
# (compose.yml, next to this file) and myapp (.devcontainer/compose.instance.yml).
# Dev-only values, not real secrets.
#
# DATABASE_URL repeats the postgres credentials from ../postgres/postgres.env
# (compose cannot interpolate an env_file's values into another service's
# environment); keep the two in sync if you change either.
DATABASE_URL=postgresql://app:app@postgres:5432/umami
# DEV ONLY. Never reuse this value outside the local devcontainer.
APP_SECRET=dev-only-0f3b6a1c9d7e4a58b2c14e6f8a90d3b7
# Rotates the visitor-hash salt daily, so visitors cannot be tracked across days.
SALT_ROTATION=day
# Read by the app, not by Umami: where and how to send analytics events.
ANALYTICS_BACKEND=umami
ANALYTICS_ENDPOINT=http://umami:3000
ANALYTICS_SITE_ID=96951c7e-f72b-5245-9755-6e3f4b9bf82c
# Event property keys the app may send (everything else is dropped), and the
# hostname Umami records events under.
ANALYTICS_PROP_KEYS=powers_count
ANALYTICS_HOSTNAME=template-fastapi.craftainer.local
