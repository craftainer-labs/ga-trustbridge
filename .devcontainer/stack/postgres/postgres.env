# Postgres local-dev credentials: loaded via env_file: into both the
# postgres service (compose.yml, next to this file) and myapp
# (.devcontainer/compose.instance.yml, which assembles DATABASE_URL from these in
# src/app/config.py). See CLAUDE.md's "Configuration" section.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
